# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Face Analysis Service URL (Python FastAPI microservice)
# For local development: http://localhost:8000/analyze-face
# For production (HuggingFace Spaces): https://YOUR-SPACE.hf.space/analyze-face
EXPO_PUBLIC_FACE_ANALYSIS_URL=http://localhost:3000/analyze-face

# Face Service URL (used by Express server to reach Python microservice)
# Set this in server environment, not in the Expo client
# FACE_SERVICE_URL=http://localhost:8000

# Legacy AWS credentials (no longer required — replaced by face-service)
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=your_aws_region